  def self.run(name : String, statements : Array(String)) : Array(String)
    directory = File.join(Dir.tempdir, "grant-write-spec-#{Process.pid}")
    pair = SQLiteWriteOracle::Pair.new(directory, name.gsub(/\W/, "_"))
    failures = [] of String
    begin
      statements.each do |sql|
        if difference = pair.step(sql)
          failures << "#{sql}\n    #{difference}"
        end
      end
      pair.c_step("ROLLBACK") unless pair.autocommit?
      pair.engine_step("ROLLBACK") if pair.session.in_transaction?
      if difference = pair.file_difference
        failures << "after the scenario: #{difference}"
      end
    ensure
      pair.close
      FileUtils.rm_rf(directory)
    end
    failures
  end

# Regenerates src/grant/text/character_class_data.cr from the PCRE2 library
# Crystal's `Regex` links, so `Grant::CharacterClass` answers exactly as the
# `\w`, `\d`, `\s` classes and case-insensitive letters of a Crystal regex do
# (Crystal compiles every regex with UTF and UCP).
#
#   crystal-alpha run scripts/generate_character_classes.cr > src/grant/text/character_class_data.cr
#
# Run it after a PCRE2 upgrade; spec/grant/text/character_class_spec.cr checks
# every code point against the linked PCRE2 and fails when the data is stale.

CLASSES = {
  "word"  => /\A\w\z/,
  "digit" => /\A\d\z/,
  "space" => /\A\s\z/,
}

def ranges_for(&) : Array({Int32, Int32})
  ranges = [] of {Int32, Int32}
  start = nil
  previous = -2
  (0..0x10FFFF).each do |code|
    next if 0xD800 <= code <= 0xDFFF
    next unless yield code.chr
    if start && code == previous + 1
      previous = code
      next
    end
    ranges << {start, previous} if start
    start = code
    previous = code
  end
  ranges << {start, previous} if start
  ranges
end

def emit(io : IO, name : String, ranges : Array({Int32, Int32})) : Nil
  io << "  # :nodoc:\n"
  io << "  private class_getter #{name} : Array({Int32, Int32}) do\n"
  io << "    data = Array({Int32, Int32}).new(#{ranges.size})\n"
  ranges.each { |(first, last)| io << "    data << {0x#{first.to_s(16).upcase}, 0x#{last.to_s(16).upcase}}\n" }
  io << "    data\n  end\n"
end

STDOUT << "# This file is generated by scripts/generate_character_classes.cr from the\n"
STDOUT << "# PCRE2 library Crystal links. Do not edit it by hand.\n\n"
STDOUT << "module Grant::CharacterClass\n"
CLASSES.each_with_index do |(name, pattern), index|
  STDOUT << "\n" if index > 0
  emit(STDOUT, "#{name}_ranges", ranges_for(&.to_s.matches?(pattern)))
end

# Non-ASCII code points that a case-insensitive regex matches against an ASCII
# letter (the Kelvin sign for `k`, the long s for `s`).
STDOUT << "\n  # :nodoc:\n"
STDOUT << "  private class_getter non_ascii_letter_folds : Hash(Char, Char) do\n"
STDOUT << "    data = {} of Char => Char\n"
('a'..'z').each do |letter|
  pattern = Regex.new("\\A#{letter}\\z", :ignore_case)
  ranges_for { |char| !char.ascii? && char.to_s.matches?(pattern) }.each do |(first, last)|
    (first..last).each { |code| STDOUT << "    data['\\u{#{code.to_s(16).upcase}}'] = '#{letter}'\n" }
  end
end
STDOUT << "    data\n  end\nend\n"

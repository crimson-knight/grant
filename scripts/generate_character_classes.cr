# Regenerates src/grant/text/character_class_data.cr from the PCRE2 library
# Crystal's `Regex` links, so `Grant::CharacterClass` answers as the `\w`, `\d`,
# `\s` classes and case-insensitive letters of a Crystal regex do on PCRE2
# 10.43 or later (Crystal compiles every regex with UTF and UCP). Those 10.43+
# tables are Grant's defined semantics on every platform, so the script stops
# when the linked PCRE2 is older.
#
#   crystal-alpha run scripts/generate_character_classes.cr > src/grant/text/character_class_data.cr
#
# Run it after a PCRE2 upgrade; spec/grant/text/character_class_spec.cr checks
# every code point against a linked PCRE2 10.43+ and fails when the data is
# stale.

# PCRE2 10.43 added nonspacing marks (U+0301) and connector punctuation
# (U+203F) to `\w`.
unless "\u0301".matches?(/\A\w\z/) && "\u203F".matches?(/\A\w\z/)
  abort "PCRE2 10.43 or later is required; the linked PCRE2 leaves nonspacing marks and connector punctuation out of \\w"
end

CLASSES = {
  "word"  => /\A\w\z/,
  "digit" => /\A\d\z/,
  "space" => /\A\s\z/,
}

def ranges_for(&) : Array({Int32, Int32})
  ranges = [] of {Int32, Int32}
  start = nil
  previous = -2
  (0..0x10FFFF).each do |code|
    next if 0xD800 <= code <= 0xDFFF
    next unless yield code.chr
    if start && code == previous + 1
      previous = code
      next
    end
    ranges << {start, previous} if start
    start = code
    previous = code
  end
  ranges << {start, previous} if start
  ranges
end

# Writes *pairs* as a method returning a read-only `Slice(UInt32)` literal: each
# pair is two consecutive entries, and the pairs are sorted by their first
# entry. A slice literal lives in the binary's read-only data, so a table costs
# its bytes and no code. A method rather than a constant: once inlined, the
# table's address and size are compile-time constants instead of loads from a
# constant's global.
def emit(io : IO, name : String, comment : String, pairs : Array({Int32, Int32})) : Nil
  io << "  # :nodoc:\n"
  io << "  #\n"
  comment.each_line { |line| io << "  # " << line << '\n' }
  io << "  def self." << name << " : Slice(UInt32)\n"
  io << "    Slice(UInt32).literal(\n"
  pairs.each_slice(4) do |row|
    io << "      "
    row.join(io, ", ") { |(first, second), row_io| row_io << "0x" << first.to_s(16).upcase << ", 0x" << second.to_s(16).upcase }
    io << ",\n"
  end
  io << "    )\n  end\n"
end

COMMENTS = {
  "word"  => "`\\w`: a letter, a number, a nonspacing mark or a connector punctuation,\nas inclusive `first, last` code point ranges.",
  "digit" => "`\\d`: a decimal digit in any script, as inclusive `first, last` code\npoint ranges.",
  "space" => "`\\s`: Unicode white space, as inclusive `first, last` code point ranges.",
}

STDOUT << "# This file is generated by scripts/generate_character_classes.cr from the\n"
STDOUT << "# PCRE2 10.43+ library Crystal links. Do not edit it by hand.\n\n"
STDOUT << "module Grant::CharacterClass\n"
CLASSES.each_with_index do |(name, pattern), index|
  STDOUT << "\n" if index > 0
  emit(STDOUT, "#{name}_ranges", COMMENTS[name], ranges_for(&.to_s.matches?(pattern)))
end

# Non-ASCII code points that a case-insensitive regex matches against an ASCII
# letter (the Kelvin sign for `k`, the long s for `s`), sorted by code point.
folds = [] of {Int32, Int32}
('a'..'z').each do |letter|
  pattern = Regex.new("\\A#{letter}\\z", :ignore_case)
  ranges_for { |char| !char.ascii? && char.to_s.matches?(pattern) }.each do |(first, last)|
    (first..last).each { |code| folds << {code, letter.ord} }
  end
end
STDOUT << "\n"
emit(STDOUT, "non_ascii_letter_folds", "Non-ASCII code points that a case-insensitive regex matches against an\nASCII letter, as `code point, lowercase ASCII letter` pairs.", folds.sort!)
STDOUT << "end\n"
